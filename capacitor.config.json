{
  "appId": "uz.narxradar.app",
  "appName": "NarxRadar",
  "webDir": "docs",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "LIGHT"
    },
    "LocalNotifications": {
      "iconColor": "#0a7c76"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "updateUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 15000,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    }
  },
  "backgroundColor": "#F1F4F2"
}